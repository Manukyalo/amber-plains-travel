# Amber Plains Travel - Environment Configuration

# Public Domain & App Routing (used for canonical URLs, Open Graph, and QR code targets)
NEXT_PUBLIC_SITE_URL=https://amber-plains-travel.vercel.app
NEXT_PUBLIC_APP_DOWNLOAD_URL=https://amber-plains-travel.vercel.app/app

# Standalone Admin Dashboard Configuration
# Set ADMIN_HOST to your custom Vercel admin domain (e.g., admin-amber-plains.vercel.app or admin.amberplains.co.ke)
ADMIN_HOST=admin-amber-plains.vercel.app
NEXT_PUBLIC_ADMIN_URL=https://admin-amber-plains.vercel.app
# Set NEXT_PUBLIC_STANDALONE_ADMIN to "true" if deploying a standalone Vercel project for the admin dashboard
NEXT_PUBLIC_STANDALONE_ADMIN=false

# App Store URLs (Leave empty during Phase 1/2 "Coming Soon" state; activate in Phase 3 when published)
NEXT_PUBLIC_APPLE_STORE_URL=
NEXT_PUBLIC_GOOGLE_PLAY_URL=

# Company Contact Metadata
NEXT_PUBLIC_COMPANY_NAME="Amber Plains Travel Ltd"
NEXT_PUBLIC_COMPANY_PHONE="+254 700 123 456"
NEXT_PUBLIC_COMPANY_WHATSAPP="+254 700 123 456"
NEXT_PUBLIC_COMPANY_EMAIL="safaris@amberplains.co.ke"
NEXT_PUBLIC_COMPANY_ADDRESS="Bamburi Beach Ridge, Mombasa, Kenya"

# Notification & Security (Server-side only)
CONTACT_NOTIFICATION_EMAIL=enquiries@amberplains.co.ke
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_MS=60000
